{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LIdP",
  "version": "0.1.0",
  "identifier": "com.aicacia.lidp",
  "build": {
    "frontendDist": "../build",
    "devUrl": "https://idp-desktop.localhost:1337",
    "beforeDevCommand": "pnpm desktop:dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["lidp", "storage"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["lidp", "storage"]
      }
    },
    "cli": {
      "description": "Local-first identity, management, and storage application",
      "args": [
        {
          "name": "config",
          "short": "c",
          "takesValue": true,
          "description": "The config path to use"
        }
      ]
    }
  }
}
